      </font>
     </property>
     <property name="text">
      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;This App is free and open-source software, distributed under the &lt;a href=&quot;https://www.gnu.org/licenses/gpl-3.0.html&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#8ab4f8;&quot;&gt;GNU GPL v3&lt;/span&gt;&lt;/a&gt; license and without any warranty.&lt;/p&gt;&lt;p&gt;If this App and the &lt;a href=&quot;https://github.com/alessandro-satanassi/OpenFIRE-Firmware-ESP32&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#8ab4f8;&quot;&gt;OpenFIRE ESP32 firmware&lt;/span&gt;&lt;/a&gt; have been useful to you, you can support Alessandro Satanassi's work:&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
     </property>
