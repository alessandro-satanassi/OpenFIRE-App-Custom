     <property name="text">
      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;This App was created by &lt;b&gt;Alessandro Satanassi&lt;/b&gt; from the original OpenFIRE App, and extended and modified for the OpenFIRE ESP32 firmware.&lt;/p&gt;&lt;p&gt;Heartfelt thanks to &lt;a href=&quot;https://github.com/SeongGino&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#8ab4f8;&quot;&gt;That One Seong&lt;/span&gt;&lt;/a&gt;, author of the &lt;a href=&quot;https://github.com/TeamOpenFIRE/OpenFIRE-App&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#8ab4f8;&quot;&gt;original OpenFIRE App&lt;/span&gt;&lt;/a&gt; and lead developer of the &lt;a href=&quot;https://github.com/TeamOpenFIRE/OpenFIRE-Firmware&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#8ab4f8;&quot;&gt;OpenFIRE firmware&lt;/span&gt;&lt;/a&gt;: without his work this App would not exist.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
     </property>
